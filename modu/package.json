{
  "name": "readawre-app",
  "private": true,
  "version": "0.2.0",
  "description": "墨读 —— Android 电子阅读器（Vue 3 + Capacitor，支持 TXT / EPUB / PDF）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-pdfjs.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "sync": "cap sync android",
    "apk": "cap build android --androidreleasetype APK",
    "postinstall": "node scripts/copy-pdfjs.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "dexie": "^4.0.10",
    "jszip": "^3.10.1",
    "pdfjs-dist": "3.11.174",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
