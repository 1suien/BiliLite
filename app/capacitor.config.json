{
  "appId": "com.bililite.app",
  "appName": "BiliLite",
  "webDir": "dist",
  "loggingBehavior": "none",
  "android": {
    "allowMixedContent": true,
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "https",
    "hostname": "www.bilibili.com"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
