    "@capacitor/app": "^6.0.2",
    "@capacitor/clipboard": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/screen-orientation": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "dexie": "4.4.6",
    "mpegts.js": "^1.7.3",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "3.5.43",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
