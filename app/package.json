{
  "name": "bililite-app",
  "private": true,
  "version": "0.4.13",
  "description": "BiliLite —— 从 debug APK 还原的 Vue 3 + Capacitor 前端工程",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
